# Where FS42 keeps confs/, catalog/ and runtime/ (created on first run)
FS42_DATA=/home/claude/fs42-data
# Root of the media library; mounted read-only at the same path inside the container
MEDIA_ROOT=/mnt/storage
# Run as this host user so files in FS42_DATA stay editable (see: id -u / id -g)
FS42_UID=1001
FS42_GID=1001
# Host groups that own /dev/dri (Quick Sync); see: getent group render video
RENDER_GID=991
VIDEO_GID=44
# Viewers' time zone (schedules use local wall-clock time; match Jellyfin's TZ)
TZ=America/Chicago
# Web console / API port on the host
FS42_PORT=4242
# Optional: a file holding a Jellyfin API key (Dashboard > API Keys). With it, Jellyfin's guide
# is refreshed whenever the schedules change, instead of once a day
JELLYFIN_KEY_FILE=/home/claude/.config/jellyfin-rescan.key
